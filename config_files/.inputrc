set completion-ignore-case
#set show-all-if-ambiguous
set editing-mode vi

# No delay when pressing escape
set keyseq-timeout 0

$if mode=vi
   set show-mode-in-prompt
   # The mode indicator is the cursor shape (DECSCUSR: 6 = beam, 2 = block).
   # The Linux virtual console does not implement DECSCUSR -- it reads
   # ESC [ n q as DECLL and toggles a keyboard LED instead, so on a bare tty
   # the cursor never changes and escape looks like it did nothing. There the
   # indicator has to be text.
   $if term=linux
      set vi-ins-mode-string +
      set vi-cmd-mode-string :
   $else
      set vi-ins-mode-string \1\e[6 q\2
      set vi-cmd-mode-string \1\e[2 q\2
   $endif

   set keymap vi-command
   "ciw": "lbcw"
   "diw": "lbdw"
   "ciW": "lBcW"
   "diW": "lBdW"
   Control-h: "^"
   # [num]yn or [num]yl -- yank num-th argument of last command
   # yank first argument of last command
   "yn": yank-nth-arg  
   # yank last argument of last command
   "yl": yank-last-arg

   set keymap vi-insert
   Control-l: clear-screen
$endif
